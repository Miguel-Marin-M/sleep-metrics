# ===========================================================================
# SleepMetrics - Backend / variables de entorno
#
# Copia este archivo a `.env` en la carpeta `backend/` y rellena los valores.
# `.env` esta en .gitignore y NUNCA debe versionarse.
#
#     cp .env.example .env         (Linux / macOS)
#     Copy-Item .env.example .env  (Windows PowerShell)
# ===========================================================================


# ---------------------------------------------------------------------------
# ENTORNO
# ---------------------------------------------------------------------------
# "development" o "production".
# En production se ocultan los detalles internos de los errores 500 y se
# deshabilita el modo de recarga automatica.
ENVIRONMENT=development


# ---------------------------------------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Formato exacto que esperan SQLAlchemy y Alembic:
#
#   postgresql+psycopg2://USUARIO:PASSWORD@HOST:PUERTO/BASEDEDATOS?sslmode=require
#
# El prefijo `postgresql+psycopg2` le indica a SQLAlchemy que use el driver
# psycopg2. Supabase entrega la cadena con el prefijo `postgresql://`; el
# backend la normaliza automaticamente, pero se recomienda escribirla ya con el
# driver explicito para que Alembic funcione igual desde la linea de comandos.
#
# USA EL "SESSION POOLER" DE SUPABASE, NO LA CONEXION DIRECTA.
# Motivo: la conexion directa (db.<ref>.supabase.co) resuelve solo a IPv6 en
# los proyectos nuevos, y la red saliente del free tier de Render es IPv4. El
# Session Pooler (puerto 5432) es compatible con IPv4 y, a diferencia del
# Transaction Pooler (puerto 6543), mantiene el estado a nivel de sesion que
# necesitan las migraciones de Alembic (LOCK, sentencias preparadas, DDL
# transaccional).
#
# Ejemplo con Session Pooler (sustituye REF, PASSWORD y REGION):
DATABASE_URL=postgresql+psycopg2://postgres.abcdefghijklmnop:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Ejemplo para PostgreSQL local (desarrollo sin Supabase):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sleepmetrics
#
# NOTA: si tu password contiene caracteres especiales (@ : / ? # [ ] %) debes
# codificarlos en percent-encoding. Por ejemplo `p@ss` se escribe `p%40ss`.


# ---------------------------------------------------------------------------
# AUTENTICACION / JWT
# ---------------------------------------------------------------------------
# Secreto de firma HS256. DEBE ser aleatorio y distinto en cada entorno.
# Generar uno con:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia-esto-por-un-secreto-aleatorio-largo-y-unico

JWT_ALGORITHM=HS256

# Vigencia del access token en minutos. 10080 = 7 dias.
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ---------------------------------------------------------------------------
# COOKIE DE SESION
# ---------------------------------------------------------------------------
# El JWT viaja en una cookie httpOnly: el JavaScript del navegador no puede
# leerla, lo que neutraliza el robo de token por XSS.
COOKIE_NAME=sleepmetrics_access_token

# COOKIE_SECURE / COOKIE_SAMESITE: valores criticos y distintos por entorno.
#
#   DESARROLLO (localhost:3000 -> localhost:8000)
#     Mismo site (el puerto no cuenta para SameSite), asi que "lax" funciona
#     y no se necesita HTTPS.
#       COOKIE_SECURE=false
#       COOKIE_SAMESITE=lax
#
#   PRODUCCION (*.vercel.app -> *.onrender.com)
#     Son sitios distintos: la cookie es cross-site y el navegador solo la
#     enviara con SameSite=None, que a su vez EXIGE Secure=true (HTTPS).
#       COOKIE_SECURE=true
#       COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Dominio de la cookie. Dejar vacio para que el navegador la asocie al host que
# la emite (el comportamiento correcto en este despliegue). Solo se rellena si
# backend y frontend comparten dominio registrable propio.
COOKIE_DOMAIN=


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Lista de origenes permitidos separados por coma. NO se puede usar "*" porque
# el envio de cookies (allow_credentials=True) lo prohibe: la especificacion de
# CORS obliga a declarar el origen exacto.
# En produccion: https://tu-dominio.algo
CORS_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------------
# CUENTAS DE DEMOSTRACION
# ---------------------------------------------------------------------------
# El boton "Probar la aplicacion" del login crea una cuenta desechable PARA
# CADA VISITANTE, ya sembrada con datos ficticios. Es lo que permite ensenar el
# proyecto en un portafolio sin obligar a nadie a registrarse.
#
# Se da una cuenta por visitante en lugar de una compartida porque, con una
# sola, el primero que borrase el historial dejaria la aplicacion vacia para
# los siguientes, y dos personas simultaneas se pisarian los datos.

# Interruptor general. Ponlo en false para desactivar la demostracion sin
# tener que redesplegar codigo.
DEMO_ACCOUNT_ENABLED=true

# Horas que vive una cuenta de demostracion antes de eliminarse junto con todos
# sus datos.
DEMO_ACCOUNT_TTL_HOURS=24

# Tope de cuentas de demostracion vivas a la vez. Protege la base de datos del
# plan gratuito frente a un bot que llame al endpoint en bucle: al superar el
# tope se eliminan las mas antiguas.
DEMO_ACCOUNT_MAX_ACTIVE=200

# Dias de historial ficticio generados en cada CUENTA DE DEMOSTRACION.
#
# OJO: esto no es un requisito de la aplicacion. Un usuario real ve su score
# desde la primera noche y sus medias desde el primer dia; lo unico que necesita
# volumen son las correlaciones, y de eso se encarga el propio servicio de
# analitica con sus umbrales.
#
# El valor es 90 porque la cuenta de demostracion tiene que ENSENAR el panel
# completo desde el primer segundo, correlaciones incluidas. Con 45 dias
# quedaban unas 30 muestras utiles y el coeficiente oscilaba entre -0.60 y +0.07
# segun la semilla del generador, asi que lo bien o mal que luciera la demo
# dependia de la suerte.
DEMO_SEED_DAYS=90


# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
# Render inyecta PORT automaticamente; en local se usa 8000 por defecto.
PORT=8000
